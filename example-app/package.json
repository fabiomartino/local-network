{
  "name": "local-network-example-app",
  "version": "8.0.0",
  "description": "Angular + Ionic demo app for @capacitor-community/local-network",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "ng": "ng",
    "version": "node ./scripts/set-version.mjs",
    "start": "pnpm run version && ng serve",
    "build": "pnpm run version && ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cap sync ios",
    "cap:sync:android": "cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:ios": "pnpm run build && cap sync ios && cap open ios",
    "build:android": "pnpm run build && cap sync android && cap open android"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@capacitor-community/local-network": "file:..",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@ionic/angular": "^9.0.10",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.2",
    "@analogjs/vitest-angular": "2.9.2",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
